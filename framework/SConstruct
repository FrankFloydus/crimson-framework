import os

from methods import print_error

root = Dir("#").abspath
if not os.path.isfile(os.path.join(root, "godot-cpp", "SConstruct")):
    print_error("Initialize godot-cpp with git submodule update --init.")
    Exit(1)

local_env = Environment(
    tools=["default"],
    PLATFORM="",
    build_profile=os.path.join(root, "build_profile.json"),
    disable_exceptions=False,
)
env = SConscript("godot-cpp/SConstruct", {"env": local_env, "api_version": "4.7"})

if (env["platform"] != "windows" or env["arch"] != "x86_64"
        or env["precision"] != "single" or env["target"] not in ("template_debug", "template_release")):
    print_error("Build Crimson Framework for Windows x86-64 single precision with target=template_debug or target=template_release.")
    Exit(1)

env.Append(CPPPATH=["#src", "#src/modules/save/third_party"], LIBS=["bcrypt"])
steam_default = os.path.join(root, "vendor", "steamworks", "sdk")
steam_headers = os.path.join(root, "vendor", "steamworks", "proton-1.65")
if not os.path.isdir(steam_default) and os.path.isdir(steam_headers):
    steam_default = steam_headers
steam_override = ARGUMENTS.get("steam_sdk") or os.environ.get("CRIMSON_STEAMWORKS_SDK")
steam_sdk = steam_override or steam_default
steam_dll = None
encrypted_ticket_dll = None
if steam_sdk.lower() != "off" and (steam_override or os.path.isdir(steam_sdk)):
    steam_sdk = os.path.abspath(steam_sdk)
    steam_include = os.path.join(steam_sdk, "public", "steam")
    if not os.path.isfile(os.path.join(steam_include, "steam_api_flat.h")):
        print_error("Set steam_sdk to a Steamworks SDK root containing public/steam, or set steam_sdk=off.")
        Exit(1)
    env.Append(CPPPATH=[os.path.dirname(steam_include), steam_include], CPPDEFINES=["CRIMSON_WITH_STEAM"])
    steam_dll = os.path.join(steam_sdk, "redistributable_bin", "win64", "steam_api64.dll")
    encrypted_ticket_dll = os.path.join(steam_include, "lib", "win64", "sdkencryptedappticket64.dll")
    sdr_default = os.path.join(root, "vendor", "steamworks", "sdr")
    sdr_override = ARGUMENTS.get("steam_sdr_sdk") or os.environ.get("CRIMSON_STEAM_SDR_SDK")
    sdr_sdk = sdr_override or sdr_default
    if sdr_sdk.lower() != "off" and (sdr_override or os.path.isdir(sdr_sdk)):
        sdr_include = os.path.join(os.path.abspath(sdr_sdk), "include")
        if not os.path.isfile(os.path.join(sdr_include, "steam", "steamdatagram_tickets.h")):
            print_error("Set steam_sdr_sdk to the Steam Game Coordinator SDK root, or set steam_sdr_sdk=off.")
            Exit(1)
        env.Append(CPPPATH=[sdr_include, os.path.join(sdr_include, "steam")],
                   CPPDEFINES=["CRIMSON_WITH_STEAM_SDR"])
sources = Glob("src/*.cpp")
for module in ("inventory", "save", "session", "scene_load", "match_runtime", "replication",
               "steam", "steam/client", "steam/client/workshop", "steam/commerce", "steam/lobbies", "steam/runtime",
               "steam/server"):
    sources += Glob(f"src/modules/{module}/*.cpp")
sources += ["src/integration/register_integration.cpp"]
doc_xml = (Glob("src/modules/inventory/doc_classes/*.xml") + Glob("src/modules/session/doc_classes/*.xml")
           + Glob("src/modules/steam/doc_classes/*.xml"))
steam_publisher = ARGUMENTS.get("steam_publisher", "no")
steam_publisher_tests = ARGUMENTS.get("steam_publisher_tests", "no")
if steam_publisher not in ("yes", "no") or steam_publisher_tests not in ("yes", "no"):
    print_error("Use yes or no for steam_publisher and steam_publisher_tests.")
    Exit(1)
if steam_publisher_tests == "yes" and steam_publisher != "yes":
    print_error("Set steam_publisher=yes to enable the publisher test transport.")
    Exit(1)
if steam_publisher == "yes":
    sources += Glob("src/modules/steam/publisher/*.cpp")
    doc_xml += Glob("src/modules/steam/publisher/doc_classes/*.xml")
    env.Append(CPPDEFINES=["CRIMSON_WITH_STEAM_PUBLISHER"])
if steam_publisher_tests == "yes":
    env.Append(CPPDEFINES=["CRIMSON_WITH_STEAM_PUBLISHER_TESTS"])
for area in ("game", "world_session", "adapters", "online", "online/steam"):
    sources += Glob(f"src/integration/{area}/*.cpp")
    doc_xml += Glob(f"src/integration/{area}/doc_classes/*.xml")
if env["target"] == "template_debug" and doc_xml:
    sources.append(env.GodotCPPDocData("src/gen/doc_data.gen.cpp", source=doc_xml))
output = "bin/publisher/windows" if steam_publisher == "yes" else "bin/windows"
install = output if steam_publisher == "yes" else "project/addons/crimson-framework/bin"
suffix = env["suffix"].replace(".dev", "")
filename = f"crimson_framework{suffix}{env['SHLIBSUFFIX']}"
library = env.SharedLibrary(f"{output}/{filename}", source=sources)
if steam_publisher == "yes":
    Default(library)
else:
    Default(env.InstallAs(f"{install}/{filename}", library[0]))
if steam_dll and os.path.isfile(steam_dll):
    Default(env.InstallAs(f"{install}/steam_api64.dll", steam_dll))
if steam_publisher == "yes" and encrypted_ticket_dll and os.path.isfile(encrypted_ticket_dll):
    Default(env.InstallAs(f"{install}/sdkencryptedappticket64.dll", encrypted_ticket_dll))
