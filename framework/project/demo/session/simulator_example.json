{
  "$comment": "Copyright Francesco Di Blasi 2026 - All Rights Reserved",
  "timeout_ms": 30000,
  "steps": [
    { "action": "assert", "field": "game.role", "op": "eq", "value": "guest" },
    { "action": "apply_profile", "preset": "slow-4g" },
    { "action": "assert", "field": "relay.uplink_kbps", "op": "eq", "value": 750 },
    {
      "action": "spike",
      "direction": "uplink",
      "extra_delay_ms": 150,
      "duration_ms": 400
    },
    { "action": "assert", "field": "relay.spike_remaining_ms", "op": "gt", "value": 0 },
    { "action": "move", "direction": "forward", "duration_ms": 200 },
    { "action": "wait_until", "field": "relay.spike_delay_ms", "op": "eq", "value": 0, "timeout_ms": 3000 },
    {
      "action": "start_scenario",
      "stages": [
        { "preset": "fast-4g", "duration_ms": 600 },
        { "preset": "constrained", "duration_ms": 600 }
      ]
    },
    { "action": "sample", "duration_ms": 1200, "interval_ms": 300 },
    { "action": "wait_until", "field": "relay.scenario_step_count", "op": "eq", "value": 0, "timeout_ms": 3000 },
    { "action": "assert", "field": "relay.uplink_kbps", "op": "eq", "value": 750 },
    { "action": "disconnect" },
    { "action": "assert", "field": "game.phase", "op": "eq", "value": "idle" },
    { "action": "reconnect" },
    { "action": "assert", "field": "game.phase", "op": "eq", "value": "running" },
    { "action": "status", "label": "After reconnect" }
  ]
}
