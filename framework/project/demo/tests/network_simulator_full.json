{
  "$comment": "Copyright Francesco Di Blasi 2026 - All Rights Reserved",
  "timeout_ms": 30000,
  "steps": [
    { "action": "assert", "field": "game.role", "op": "eq", "value": "guest" },
    { "action": "assert", "field": "game.phase", "op": "eq", "value": "running" },
    { "action": "assert", "field": "game.player_count", "op": "gte", "value": 1 },
    { "action": "list_profiles" },
    { "action": "save_profile", "name": "Lab link", "settings": { "delay_ms": 20, "jitter_ms": 5, "uplink_kbps": 320, "downlink_kbps": 900 } },
    { "action": "apply_profile", "saved": "Lab link" },
    { "action": "assert", "field": "relay.downlink_kbps", "op": "eq", "value": 900 },
    { "action": "assert", "field": "relay.uplink_kbps", "op": "eq", "value": 320 },
    { "action": "reset_counters" },
    { "action": "status", "label": "Before movement" },
    { "action": "move", "direction": "forward", "duration_ms": 700 },
    { "action": "wait_until", "field": "game.acknowledged_input", "op": "gt", "value": 0, "timeout_ms": 4000 },
    { "action": "assert", "field": "relay.uplink.forwarded_bytes", "op": "gt", "value": 0 },
    { "action": "assert", "field": "relay.downlink.forwarded_bytes", "op": "gt", "value": 0 },
    { "action": "spike", "direction": "uplink", "extra_delay_ms": 450, "duration_ms": 350, "start_delay_ms": 250 },
    { "action": "assert", "field": "relay.spike_starts_in_ms", "op": "gt", "value": 0 },
    { "action": "wait_until", "field": "relay.spike_delay_ms", "op": "eq", "value": 0, "timeout_ms": 3000 },
    { "action": "spike", "extra_delay_ms": 150, "duration_ms": 2500, "start_delay_ms": 2000 },
    { "action": "cancel_spike" },
    { "action": "assert", "field": "relay.spike_delay_ms", "op": "eq", "value": 0 },
    { "action": "outage", "direction": "uplink", "duration_ms": 650, "start_delay_ms": 200 },
    { "action": "wait_until", "field": "relay.link_dropped", "op": "eq", "value": true, "timeout_ms": 3000 },
    { "action": "assert", "field": "relay.outage_direction", "op": "eq", "value": "uplink" },
    { "action": "wait_until", "field": "relay.link_dropped", "op": "eq", "value": false, "timeout_ms": 3000 },
    { "action": "drop_link" },
    { "action": "assert", "field": "relay.outage_remaining_ms", "op": "eq", "value": -1 },
    { "action": "resume_link" },
    { "action": "assert", "field": "relay.link_dropped", "op": "eq", "value": false },
    {
      "action": "start_scenario",
      "start_delay_ms": 100,
      "stages": [
        { "label": "Congested", "preset": "constrained", "duration_ms": 400 },
        { "label": "Outage", "saved": "Lab link", "duration_ms": 500, "outage": "downlink" }
      ]
    },
    { "action": "wait_until", "field": "relay.scenario_step", "op": "eq", "value": 1, "timeout_ms": 3000 },
    { "action": "assert", "field": "relay.outage_direction", "op": "eq", "value": "downlink" },
    { "action": "sample", "duration_ms": 350, "interval_ms": 100 },
    { "action": "wait_until", "field": "relay.scenario_step_count", "op": "eq", "value": 0, "timeout_ms": 3000 },
    { "action": "assert", "field": "relay.uplink_kbps", "op": "eq", "value": 320 },
    { "action": "start_scenario", "template": "profile-cycle", "loop": true },
    { "action": "stop_scenario" },
    { "action": "assert", "field": "relay.downlink_kbps", "op": "eq", "value": 900 },
    { "action": "status", "label": "Before reconnect" },
    { "action": "disconnect" },
    { "action": "assert", "field": "game.phase", "op": "eq", "value": "idle" },
    { "action": "reconnect" },
    { "action": "assert", "field": "game.phase", "op": "eq", "value": "running" },
    { "action": "assert", "field": "relay.link_dropped", "op": "eq", "value": false },
    { "action": "status", "label": "After reconnect" }
  ]
}
