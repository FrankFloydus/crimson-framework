      ],
      "cases":[
        {"start":{"meta":{"targets_remaining":0,"wave":2,"checkpoint_blocked":false}},"expect":{"meta":{"targets_remaining":12,"wave":3,"checkpoint_blocked":false}}},
        {"start":{"meta":{"targets_remaining":1,"wave":2,"checkpoint_blocked":false}},"expect":{"meta":{"targets_remaining":1,"wave":2,"checkpoint_blocked":true}}},
        {"start":{"meta":{"targets_remaining":0,"wave":3,"checkpoint_blocked":false}},"expect":{"meta":{"targets_remaining":12,"wave":4,"checkpoint_blocked":false}}}
      ]
    },
    {
      "id":"teleport_pad","family":"movement","label":"Teleport the body to a destination when its cooldown is ready",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"teleport_cooldown"},0],"store":"ticks_left","type":"int"},
        {"if":["eq",{"ref":"ticks_left"},0],"then":[
          {"call":"set_position","target":"body","args":[{"vec3":[8,2,-10]}]},
