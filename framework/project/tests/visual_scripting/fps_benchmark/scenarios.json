        {"start":{"meta":{"stamina":10,"vaulted":true},"position":[-2,0,0]},"expect":{"meta":{"stamina":10,"vaulted":false},"position":[-2,0,0]}},
        {"start":{"meta":{"stamina":15,"vaulted":false},"position":[1,0,0]},"expect":{"meta":{"stamina":0,"vaulted":true},"position":[2,2,0]}}
      ]
    },
    {
