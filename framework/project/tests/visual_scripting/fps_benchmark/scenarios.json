{
  "copyright": "Copyright Francesco Di Blasi 2026 - All Rights Reserved",
  "version": 1,
  "methods": {
    "get_meta": {"class":"Object","name":"get_meta","args":[{"name":"Name","type":"name"},{"name":"Default","type":"variant"}],"returns":"variant","const":true},
    "set_meta": {"class":"Object","name":"set_meta","args":[{"name":"Name","type":"name"},{"name":"Value","type":"variant"}],"returns":null},
    "add_group": {"class":"Node","name":"add_to_group","args":[{"name":"Group","type":"name"},{"name":"Persistent","type":"bool"}],"returns":null},
    "remove_group": {"class":"Node","name":"remove_from_group","args":[{"name":"Group","type":"name"}],"returns":null},
    "in_group": {"class":"Node","name":"is_in_group","args":[{"name":"Group","type":"name"}],"returns":"bool","const":true},
    "set_position": {"class":"Node3D","name":"set_position","args":[{"name":"Position","type":"vec3"}],"returns":null},
    "show": {"class":"Node3D","name":"show","args":[],"returns":null},
    "hide": {"class":"Node3D","name":"hide","args":[],"returns":null}
  },
  "scenarios": [
    {
      "id":"fire_round","family":"combat","label":"Consume one round when the weapon fires",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"magazine"},0],"store":"rounds","type":"int"},
        {"if":["gt",{"ref":"rounds"},0],"then":[
          {"call":"set_meta","target":"body","args":[{"name":"magazine"},["sub",{"ref":"rounds"},1]]},
          {"call":"set_meta","target":"body","args":[{"name":"shot_fired"},true]}
        ],"else":[{"call":"set_meta","target":"body","args":[{"name":"shot_fired"},false]}]}
      ],
      "cases":[
        {"start":{"meta":{"magazine":12,"shot_fired":false}},"expect":{"meta":{"magazine":11,"shot_fired":true}}},
        {"start":{"meta":{"magazine":1,"shot_fired":false}},"expect":{"meta":{"magazine":0,"shot_fired":true}}},
        {"start":{"meta":{"magazine":0,"shot_fired":true}},"expect":{"meta":{"magazine":0,"shot_fired":false}}}
      ]
    },
    {
      "id":"reload_magazine","family":"combat","label":"Transfer reserve ammunition into a six-round magazine",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"magazine"},0],"store":"rounds","type":"int"},
        {"call":"get_meta","target":"body","args":[{"name":"reserve"},0],"store":"reserve_rounds","type":"int"},
        {"if":["ge",{"ref":"reserve_rounds"},["sub",6,{"ref":"rounds"}]],"then":[
          {"call":"set_meta","target":"body","args":[{"name":"magazine"},6]},
          {"call":"set_meta","target":"body","args":[{"name":"reserve"},["sub",{"ref":"reserve_rounds"},["sub",6,{"ref":"rounds"}]]]}
        ],"else":[
          {"call":"set_meta","target":"body","args":[{"name":"magazine"},["add",{"ref":"rounds"},{"ref":"reserve_rounds"}]]},
          {"call":"set_meta","target":"body","args":[{"name":"reserve"},0]}
        ]}
      ],
      "cases":[
        {"start":{"meta":{"magazine":2,"reserve":9}},"expect":{"meta":{"magazine":6,"reserve":5}}},
        {"start":{"meta":{"magazine":1,"reserve":3}},"expect":{"meta":{"magazine":4,"reserve":0}}},
        {"start":{"meta":{"magazine":6,"reserve":4}},"expect":{"meta":{"magazine":6,"reserve":4}}}
      ]
    },
    {
      "id":"armor_absorb","family":"combat","label":"Apply damage to armor before health",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"armor"},0],"store":"armor_points","type":"int"},
        {"call":"get_meta","target":"body","args":[{"name":"health"},0],"store":"health_points","type":"int"},
        {"if":["ge",{"ref":"armor_points"},20],"then":[
          {"call":"set_meta","target":"body","args":[{"name":"armor"},["sub",{"ref":"armor_points"},20]]}
        ],"else":[
          {"call":"set_meta","target":"body","args":[{"name":"armor"},0]},
          {"call":"set_meta","target":"body","args":[{"name":"health"},["sub",{"ref":"health_points"},["sub",20,{"ref":"armor_points"}]]]}
        ]}
      ],
      "cases":[
        {"start":{"meta":{"armor":40,"health":100}},"expect":{"meta":{"armor":20,"health":100}}},
        {"start":{"meta":{"armor":5,"health":75}},"expect":{"meta":{"armor":0,"health":60}}},
        {"start":{"meta":{"armor":0,"health":50}},"expect":{"meta":{"armor":0,"health":30}}}
      ]
    },
    {
      "id":"hit_reaction","family":"combat","label":"Record hit damage and hide a defeated actor",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"health"},0],"store":"health_points","type":"int"},
        {"if":["gt",{"ref":"health_points"},30],"then":[
          {"call":"set_meta","target":"body","args":[{"name":"health"},["sub",{"ref":"health_points"},30]]}
        ],"else":[
          {"call":"set_meta","target":"body","args":[{"name":"health"},0]},
          {"call":"add_group","target":"body","args":[{"name":"defeated"},false]},
          {"call":"hide","target":"body","args":[]}
        ]}
      ],
      "cases":[
        {"start":{"meta":{"health":75},"visible":true,"groups":[]},"expect":{"meta":{"health":45},"visible":true,"groups":[]}},
        {"start":{"meta":{"health":12},"visible":true,"groups":[]},"expect":{"meta":{"health":0},"visible":false,"groups":["defeated"]}},
        {"start":{"meta":{"health":30},"visible":true,"groups":[]},"expect":{"meta":{"health":0},"visible":false,"groups":["defeated"]}}
      ]
    },
    {
      "id":"shield_gate","family":"combat","label":"Drain shield charge and mark a shield break",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"shield"},0],"store":"shield_points","type":"int"},
        {"if":["gt",{"ref":"shield_points"},15],"then":[
          {"call":"set_meta","target":"body","args":[{"name":"shield"},["sub",{"ref":"shield_points"},15]]},
          {"call":"set_meta","target":"body","args":[{"name":"shield_broken"},false]}
        ],"else":[
          {"call":"set_meta","target":"body","args":[{"name":"shield"},0]},
          {"call":"set_meta","target":"body","args":[{"name":"shield_broken"},true]}
        ]}
      ],
      "cases":[
        {"start":{"meta":{"shield":35,"shield_broken":true}},"expect":{"meta":{"shield":20,"shield_broken":false}}},
        {"start":{"meta":{"shield":15,"shield_broken":false}},"expect":{"meta":{"shield":0,"shield_broken":true}}},
        {"start":{"meta":{"shield":5,"shield_broken":false}},"expect":{"meta":{"shield":0,"shield_broken":true}}}
      ]
    },
    {
      "id":"switch_weapon","family":"combat","label":"Equip the held secondary weapon when unlocked",
      "steps":[
        {"call":"in_group","target":"body","args":[{"name":"has_secondary"}],"store":"secondary_unlocked"},
        {"if":{"ref":"secondary_unlocked"},"then":[
          {"call":"remove_group","target":"body","args":[{"name":"primary_equipped"}]},
          {"call":"add_group","target":"body","args":[{"name":"secondary_equipped"},false]},
          {"call":"set_meta","target":"body","args":[{"name":"weapon_slot"},2]}
        ],"else":[
          {"call":"set_meta","target":"body","args":[{"name":"weapon_slot"},1]}
        ]}
      ],
      "cases":[
        {"start":{"meta":{"weapon_slot":1},"groups":["has_secondary","primary_equipped"]},"expect":{"meta":{"weapon_slot":2},"groups":["has_secondary","secondary_equipped"]}},
        {"start":{"meta":{"weapon_slot":0},"groups":["primary_equipped"]},"expect":{"meta":{"weapon_slot":1},"groups":["primary_equipped"]}},
        {"start":{"meta":{"weapon_slot":2},"groups":["has_secondary","secondary_equipped"]},"expect":{"meta":{"weapon_slot":2},"groups":["has_secondary","secondary_equipped"]}}
      ]
    },
    {
      "id":"health_pickup","family":"items","label":"Heal a player without exceeding maximum health",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"health"},0],"store":"health_points","type":"int"},
        {"if":["lt",{"ref":"health_points"},75],"then":[
          {"call":"set_meta","target":"body","args":[{"name":"health"},["add",{"ref":"health_points"},25]]}
        ],"else":[{"call":"set_meta","target":"body","args":[{"name":"health"},100]}]}
      ],
      "cases":[
        {"start":{"meta":{"health":25}},"expect":{"meta":{"health":50}}},
        {"start":{"meta":{"health":88}},"expect":{"meta":{"health":100}}},
        {"start":{"meta":{"health":74}},"expect":{"meta":{"health":99}}},
        {"start":{"meta":{"health":55}},"expect":{"meta":{"health":80}}}
      ]
    },
    {
      "id":"ammo_pickup","family":"items","label":"Add reserve ammunition up to carrying capacity",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"reserve"},0],"store":"reserve_rounds","type":"int"},
        {"if":["le",{"ref":"reserve_rounds"},108],"then":[
          {"call":"set_meta","target":"body","args":[{"name":"reserve"},["add",{"ref":"reserve_rounds"},12]]}
        ],"else":[{"call":"set_meta","target":"body","args":[{"name":"reserve"},120]}]}
      ],
      "cases":[
        {"start":{"meta":{"reserve":0}},"expect":{"meta":{"reserve":12}}},
        {"start":{"meta":{"reserve":113}},"expect":{"meta":{"reserve":120}}},
        {"start":{"meta":{"reserve":108}},"expect":{"meta":{"reserve":120}}}
      ]
    },
    {
      "id":"armor_pickup","family":"items","label":"Pick up armor unless stronger armor is already equipped",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"armor"},0],"store":"armor_points","type":"int"},
        {"if":["lt",{"ref":"armor_points"},50],"then":[
          {"call":"set_meta","target":"body","args":[{"name":"armor"},50]},
          {"call":"set_meta","target":"body","args":[{"name":"picked_up_armor"},true]}
        ],"else":[{"call":"set_meta","target":"body","args":[{"name":"picked_up_armor"},false]}]}
      ],
      "cases":[
        {"start":{"meta":{"armor":40,"picked_up_armor":false}},"expect":{"meta":{"armor":50,"picked_up_armor":true}}},
        {"start":{"meta":{"armor":70,"picked_up_armor":true}},"expect":{"meta":{"armor":70,"picked_up_armor":false}}},
        {"start":{"meta":{"armor":50,"picked_up_armor":true}},"expect":{"meta":{"armor":50,"picked_up_armor":false}}}
      ]
    },
    {
      "id":"keycard_pickup","family":"items","label":"Add a keycard to inventory on first pickup",
      "steps":[
        {"call":"in_group","target":"body","args":[{"name":"red_keycard"}],"store":"has_keycard"},
        {"if":{"ref":"has_keycard"},"then":[
          {"call":"set_meta","target":"body","args":[{"name":"keycard_added"},false]}
        ],"else":[
          {"call":"add_group","target":"body","args":[{"name":"red_keycard"},false]},
          {"call":"set_meta","target":"body","args":[{"name":"keycard_added"},true]}
        ]}
      ],
      "cases":[
        {"start":{"meta":{"keycard_added":false},"groups":[]},"expect":{"meta":{"keycard_added":true},"groups":["red_keycard"]}},
        {"start":{"meta":{"keycard_added":true},"groups":["red_keycard"]},"expect":{"meta":{"keycard_added":false},"groups":["red_keycard"]}}
      ]
    },
    {
      "id":"powerup_pickup","family":"items","label":"Start or extend a temporary speed powerup",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"speed_ticks"},0],"store":"speed_ticks_left","type":"int"},
        {"if":["gt",{"ref":"speed_ticks_left"},0],"then":[
          {"call":"set_meta","target":"body","args":[{"name":"speed_ticks"},["add",{"ref":"speed_ticks_left"},150]]}
        ],"else":[
          {"call":"add_group","target":"body","args":[{"name":"speed_boost"},false]},
          {"call":"set_meta","target":"body","args":[{"name":"speed_ticks"},150]}
        ]}
      ],
      "cases":[
        {"start":{"meta":{"speed_ticks":0},"groups":[]},"expect":{"meta":{"speed_ticks":150},"groups":["speed_boost"]}},
        {"start":{"meta":{"speed_ticks":75},"groups":["speed_boost"]},"expect":{"meta":{"speed_ticks":225},"groups":["speed_boost"]}},
        {"start":{"meta":{"speed_ticks":1},"groups":["speed_boost"]},"expect":{"meta":{"speed_ticks":151},"groups":["speed_boost"]}}
      ]
    },
    {
      "id":"use_medkit","family":"items","label":"Spend an inventory medkit only when it can heal",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"medkits"},0],"store":"medkit_count","type":"int"},
        {"call":"get_meta","target":"body","args":[{"name":"health"},0],"store":"health_points","type":"int"},
        {"if":["gt",{"ref":"medkit_count"},0],"then":[
          {"if":["lt",{"ref":"health_points"},100],"then":[
            {"call":"set_meta","target":"body","args":[{"name":"medkits"},["sub",{"ref":"medkit_count"},1]]},
            {"if":["lt",{"ref":"health_points"},60],"then":[
              {"call":"set_meta","target":"body","args":[{"name":"health"},["add",{"ref":"health_points"},40]]}
            ],"else":[{"call":"set_meta","target":"body","args":[{"name":"health"},100]}]}
          ],"else":[]}
        ],"else":[]}
      ],
      "cases":[
        {"start":{"meta":{"medkits":2,"health":35}},"expect":{"meta":{"medkits":1,"health":75}}},
        {"start":{"meta":{"medkits":1,"health":90}},"expect":{"meta":{"medkits":0,"health":100}}},
        {"start":{"meta":{"medkits":0,"health":35}},"expect":{"meta":{"medkits":0,"health":35}}},
        {"start":{"meta":{"medkits":2,"health":100}},"expect":{"meta":{"medkits":2,"health":100}}}
      ]
    },
    {
      "id":"capture_flag","family":"objective","label":"Score a point when a flag carrier reaches the capture zone",
      "steps":[
        {"call":"in_group","target":"body","args":[{"name":"flag_carrier"}],"store":"has_flag"},
        {"if":{"ref":"has_flag"},"then":[
          {"call":"get_meta","target":"body","args":[{"name":"captures"},0],"store":"capture_count","type":"int"},
          {"call":"set_meta","target":"body","args":[{"name":"captures"},["add",{"ref":"capture_count"},1]]},
          {"call":"remove_group","target":"body","args":[{"name":"flag_carrier"}]}
        ],"else":[]}
      ],
      "cases":[
        {"start":{"meta":{"captures":0},"groups":["flag_carrier"]},"expect":{"meta":{"captures":1},"groups":[]}},
        {"start":{"meta":{"captures":2},"groups":[]},"expect":{"meta":{"captures":2},"groups":[]}},
        {"start":{"meta":{"captures":4},"groups":["flag_carrier"]},"expect":{"meta":{"captures":5},"groups":[]}}
      ]
    },
    {
      "id":"capture_control_point","family":"objective","label":"Advance team capture progress and mark a completed capture",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"capture_progress"},0],"store":"progress_points","type":"int"},
        {"if":["lt",{"ref":"progress_points"},80],"then":[
          {"call":"set_meta","target":"body","args":[{"name":"capture_progress"},["add",{"ref":"progress_points"},20]]}
        ],"else":[
          {"call":"set_meta","target":"body","args":[{"name":"capture_progress"},100]},
          {"call":"add_group","target":"body","args":[{"name":"point_captured"},false]}
        ]}
      ],
      "cases":[
        {"start":{"meta":{"capture_progress":20},"groups":[]},"expect":{"meta":{"capture_progress":40},"groups":[]}},
        {"start":{"meta":{"capture_progress":90},"groups":[]},"expect":{"meta":{"capture_progress":100},"groups":["point_captured"]}},
        {"start":{"meta":{"capture_progress":80},"groups":[]},"expect":{"meta":{"capture_progress":100},"groups":["point_captured"]}}
      ]
    },
    {
      "id":"flag_pickup","family":"objective","label":"Give an eligible player the flag",
      "steps":[
        {"call":"in_group","target":"body","args":[{"name":"flag_carrier"}],"store":"already_carrying"},
        {"if":{"ref":"already_carrying"},"then":[
          {"call":"set_meta","target":"body","args":[{"name":"flag_picked_up"},false]}
        ],"else":[
          {"call":"add_group","target":"body","args":[{"name":"flag_carrier"},false]},
          {"call":"set_meta","target":"body","args":[{"name":"flag_picked_up"},true]}
        ]}
      ],
      "cases":[
        {"start":{"meta":{"flag_picked_up":false},"groups":[]},"expect":{"meta":{"flag_picked_up":true},"groups":["flag_carrier"]}},
        {"start":{"meta":{"flag_picked_up":true},"groups":["flag_carrier"]},"expect":{"meta":{"flag_picked_up":false},"groups":["flag_carrier"]}}
      ]
    },
    {
      "id":"interact_team_terminal","family":"objective","label":"Authenticate a player at a team-only terminal",
      "steps":[
        {"call":"in_group","target":"body","args":[{"name":"blue_team"}],"store":"matches_team"},
        {"if":{"ref":"matches_team"},"then":[
          {"call":"add_group","target":"body","args":[{"name":"terminal_access"},false]},
          {"call":"set_meta","target":"body","args":[{"name":"access_granted"},true]}
        ],"else":[
          {"call":"remove_group","target":"body","args":[{"name":"terminal_access"}]},
          {"call":"set_meta","target":"body","args":[{"name":"access_granted"},false]}
        ]}
      ],
      "cases":[
        {"start":{"meta":{"access_granted":false},"groups":["blue_team"]},"expect":{"meta":{"access_granted":true},"groups":["blue_team","terminal_access"]}},
        {"start":{"meta":{"access_granted":true},"groups":["red_team","terminal_access"]},"expect":{"meta":{"access_granted":false},"groups":["red_team"]}},
        {"start":{"meta":{"access_granted":true},"groups":["blue_team","terminal_access"]},"expect":{"meta":{"access_granted":true},"groups":["blue_team","terminal_access"]}}
      ]
    },
    {
      "id":"escort_checkpoint","family":"objective","label":"Advance an active escort at the next checkpoint",
      "steps":[
        {"call":"in_group","target":"body","args":[{"name":"escorting"}],"store":"is_escorting"},
        {"if":{"ref":"is_escorting"},"then":[
          {"call":"get_meta","target":"body","args":[{"name":"escort_stage"},0],"store":"escort_stage_index","type":"int"},
          {"call":"set_meta","target":"body","args":[{"name":"escort_stage"},["add",{"ref":"escort_stage_index"},1]]}
        ],"else":[]}
      ],
      "cases":[
        {"start":{"meta":{"escort_stage":0},"groups":["escorting"]},"expect":{"meta":{"escort_stage":1},"groups":["escorting"]}},
        {"start":{"meta":{"escort_stage":1},"groups":[]},"expect":{"meta":{"escort_stage":1},"groups":[]}},
        {"start":{"meta":{"escort_stage":3},"groups":["escorting"]},"expect":{"meta":{"escort_stage":4},"groups":["escorting"]}}
      ]
    },
    {
      "id":"complete_wave_checkpoint","family":"objective","label":"Advance the wave checkpoint only after the target count",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"targets_remaining"},0],"store":"targets_left","type":"int"},
        {"if":["eq",{"ref":"targets_left"},0],"then":[
          {"call":"get_meta","target":"body","args":[{"name":"wave"},0],"store":"wave_index","type":"int"},
          {"call":"set_meta","target":"body","args":[{"name":"wave"},["add",{"ref":"wave_index"},1]]},
          {"call":"set_meta","target":"body","args":[{"name":"targets_remaining"},12]}
