          {"call":"set_position","target":"body","args":[{"vec3":[2,2,0]}]},
          {"call":"set_meta","target":"body","args":[{"name":"stamina"},["sub",{"ref":"stamina_points"},15]]},
          {"call":"set_meta","target":"body","args":[{"name":"vaulted"},true]}
