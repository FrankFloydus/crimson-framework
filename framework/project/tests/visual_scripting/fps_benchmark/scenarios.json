        ],"else":[]}
      ],
      "cases":[
        {"start":{"meta":{"teleport_cooldown":0},"position":[1,0,2]},"expect":{"meta":{"teleport_cooldown":30},"position":[8,2,-10]}},
        {"start":{"meta":{"teleport_cooldown":10},"position":[-4,0,2]},"expect":{"meta":{"teleport_cooldown":10},"position":[-4,0,2]}},
        {"start":{"meta":{"teleport_cooldown":0},"position":[-2,3,1]},"expect":{"meta":{"teleport_cooldown":30},"position":[8,2,-10]}}
      ]
    },
    {
      "id":"vault_trigger","family":"movement","label":"Move a player onto a vault ledge when stamina permits",
      "steps":[
        {"call":"get_meta","target":"body","args":[{"name":"stamina"},0],"store":"stamina_points","type":"int"},
