      ],
      "cases":[
        {"start":{"meta":{"movement_mode":0},"groups":[]},"expect":{"meta":{"movement_mode":2},"groups":["climbing"]}},
        {"start":{"meta":{"movement_mode":2},"groups":["climbing"]},"expect":{"meta":{"movement_mode":0},"groups":[]}}
      ]
    },
    {
      "id":"evacuation_exit","family":"movement","label":"Move the cleared player to the extraction zone",
      "steps":[
