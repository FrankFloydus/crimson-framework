[configuration]

entry_symbol = "crimson_framework_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

windows.debug.x86_64.single = "./bin/crimson_framework.windows.template_debug.x86_64.dll"
windows.release.x86_64.single = "./bin/crimson_framework.windows.template_release.x86_64.dll"
